# Optional: increases GitHub rate limits and enables private repo access for the user.
GITHUB_TOKEN=

# Optional: when set, write-side actions (PR creation) only operate on repos
# owned by this user. Critical safety guardrail when GITHUB_TOKEN is shared.
GITHUB_WRITE_OWNER=

# Optional: enables LLM-generated developer story. Profile still works without it.
OPENAI_API_KEY=

# CORS — defaults to the Next.js dev server.
CORS_ORIGINS=["http://localhost:3000","https://ai-portfolio-agent.vercel.app"]

# Optional: Vercel KV / Upstash REST persistence for owner customizations.
# Add these to the ai-portfolio-agent-api Vercel project only.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional but required to save resume/Vercel customizations when KV is on.
# Add these to the ai-portfolio-agent-api Vercel project. The web project
# also needs its own Clerk vars; see web/.env.local.example.
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
