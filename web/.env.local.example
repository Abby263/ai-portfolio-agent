# Where the FastAPI backend is running.
# Local dev:
NEXT_PUBLIC_API_URL=http://localhost:8000
# Production reference:
# NEXT_PUBLIC_API_URL=https://ai-portfolio-agent-api.vercel.app

# Optional: enables Clerk GitHub sign-in in the Next.js web app.
# Add both to the ai-portfolio-agent Vercel project.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
